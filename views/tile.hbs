<!doctype html>
<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{{title}}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
		<link rel="stylesheet" href="/style.css" />
	</head>
	<body>
		<h1 class="page-title">Каталог шин</h1>

		<form action="/tire_types" method="GET" class="filter-form">
			<label>Радиус колеса</label>
			<div class="range-slider">
				<input type="range" name="radiusMin" min="{{radiusLimits.min}}" max="{{radiusLimits.max}}" step="1" value="{{radiusMin}}" />
				<input type="range" name="radiusMax" min="{{radiusLimits.min}}" max="{{radiusLimits.max}}" step="1" value="{{radiusMax}}" />
			</div>
			<div class="range-scale">
				<span>R{{radiusLimits.min}}</span>
				<span class="range-selected">R{{radiusMin}} – R{{radiusMax}}</span>
				<span>R{{radiusLimits.max}}</span>
			</div>
			<button type="submit" class="filter-btn">Найти</button>
		</form>

		<div class="tile-grid">
			{{#each tireTypes}}
			<div class="tire-type-card">
				<a href="/tire_types/{{this.id}}/feed" class="tire-type-link">
					<img src="{{this.imageUrl}}" alt="{{this.title}}" />
					<h3>{{this.title}}</h3>
					<p class="likes">♡ {{this.likesCount}}</p>
					<span class="tire-type-badge">{{this.season}}</span>
					<p class="tire-type-radius">Радиус: R{{this.radius}}</p>
				</a>
				<form method="POST" action="/tire_types/{{this.id}}/delete" class="delete-form">
					<input type="hidden" name="radiusMin" value="{{../radiusMin}}" />
					<input type="hidden" name="radiusMax" value="{{../radiusMax}}" />
					<button type="submit" class="submit-btn">Удалить</button>
				</form>
			</div>
			{{else}}
			<p>Ничего не найдено</p>
			{{/each}}
		</div>

		{{> nav }}
	</body>
</html>
