<!doctype html>
<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{{title}}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
		<link rel="stylesheet" href="/style.css" />
	</head>
	<body>
		<div class="add-page-wrap">
			<div class="add-form-card">
				<h2>Добавление шин</h2>

				<div class="media-block">
					<div class="media-row">
						<label>Фото</label>
						<div class="media-controls">
							<label for="image-input" class="media-btn">Обновить</label>
							<input type="file" id="image-input" class="file-input" accept="image/*" />
							<img class="media-preview" src="{{tireType.imageUrl}}" alt="Превью фото" />
						</div>
					</div>

					<div class="media-row">
						<label>Видео</label>
						<div class="media-controls">
							<label for="video-input" class="media-btn">Обновить</label>
							<input type="file" id="video-input" class="file-input" accept="video/*" />
							<video class="media-preview" src="{{tireType.videoUrl}}#t=0.1" muted playsinline preload="metadata"></video>
						</div>
					</div>
				</div>

				<div class="text-block">
					<label>Название</label>
					<input type="text" placeholder="{{tireType.title}}" />

					<label>Описание</label>
					<textarea placeholder="{{tireType.description}}"></textarea>
				</div>

				<div class="fields-block">
					<label>Оптимальное давление</label>
					<input type="number" step="0.1" placeholder="{{tireType.optimalPressure}}" />

					<label>Радиус колеса</label>
					<input type="number" step="1" placeholder="{{tireType.radius}}" />
				</div>

				<div class="type-toggle"><span>Все</span><span>Лето</span><span class="active">Зима</span></div>
			</div>
		</div>
		{{> nav }}
	</body>
</html>
