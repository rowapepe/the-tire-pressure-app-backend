<!doctype html>
<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{{title}}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
		<link rel="stylesheet" href="/style.css" />
	</head>
	<body>
		<div class="add-page-wrap">
			<form class="add-form-card" method="POST" action="{{#if tireType}}/tire_types/{{tireType.id}}/publish{{else}}/tire_types{{/if}}">
				<h2>Добавление шин</h2>

				<div class="media-block">
					<div class="media-row">
						<label>Фото</label>
						<div class="media-controls">
							<label for="image-input" class="media-btn">Обновить</label>
							<input type="file" id="image-input" class="file-input" accept="image/*" />
							<img class="media-preview" src="{{#if tireType}}{{tireType.imageUrl}}{{else}}/default.jpg{{/if}}" alt="Превью фото" />
						</div>
					</div>

					<div class="media-row">
						<label>Видео</label>
						<div class="media-controls">
							<label for="video-input" class="media-btn">Обновить</label>
							<input type="file" id="video-input" class="file-input" accept="video/*" />
							<video class="media-preview" src="{{#if tireType}}{{tireType.videoUrl}}{{else}}/default.MOV{{/if}}#t=0.1" muted playsinline preload="metadata"></video>
						</div>
					</div>
				</div>

				<div class="text-block">
					<label for="title">Название</label>
					<input type="text" id="title" name="title" maxlength="100" required value="{{tireType.title}}" />

					{{#if tireType}}
					<label for="description">Описание</label>
					<textarea id="description" name="description" maxlength="500" required>{{tireType.description}}</textarea>
					{{/if}}
				</div>

				{{#if tireType}}
				<div class="fields-block">
					<label for="optimalPressure">Оптимальное давление</label>
					<input type="number" id="optimalPressure" name="optimalPressure" step="0.1" min="0.5" max="9.9" required value="{{tireType.optimalPressure}}" />

					<label for="radius">Радиус колеса</label>
					<input type="number" id="radius" name="radius" step="1" min="13" max="22" required value="{{tireType.radius}}" />
				</div>

				<div class="type-toggle">
					{{#each seasons}}
					<label>
						<input type="radio" name="season" value="{{this.name}}" required {{#if this.checked}}checked{{/if}} />
						<span>{{this.name}}</span>
					</label>
					{{/each}}
				</div>

				<button type="submit" class="submit-btn">Опубликовать</button>
				{{else}}
				<button type="submit" class="submit-btn">Далее</button>
				{{/if}}
			</form>
		</div>
		{{> nav }}
	</body>
</html>
