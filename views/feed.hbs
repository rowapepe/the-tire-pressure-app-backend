<!doctype html>
<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{{title}}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
		<link rel="stylesheet" href="/style.css" />
	</head>
	<body class="feed-page">
		<div class="feed-container">
			<video src="{{tireType.videoUrl}}" poster="{{tireType.imageUrl}}" autoplay muted loop playsinline></video>
			<div class="feed-overlay">
				<div class="feed-text">
					<h2>{{tireType.title}}</h2>
					<details class="feed-more">
						<summary>
							<span class="feed-description">{{tireType.description}}</span>
							<span class="more-link more-open">Больше</span>
							<span class="more-link more-close">Меньше</span>
						</summary>
					</details>
				</div>
				<div class="feed-fields">
					<span>Оптимальное давление: {{tireType.optimalPressure}} бар</span>
					<span>Радиус: R{{tireType.radius}}</span>
				</div>
			</div>
			<div class="feed-actions">
				<div class="like-btn">
					<span class="like-icon"><img src="/icons/like.png" alt="Лайк" /></span>
					<span>{{tireType.likesCount}}</span>
				</div>
				<a href="/tire_types/{{tireType.id}}/feed?next=true" class="next-btn"><img src="/icons/next.png" alt="Следующий" /></a>
			</div>
		</div>
		{{> nav }}
	</body>
</html>
